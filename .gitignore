# Original textures over 5 MiB are restored locally from the licensed packs.
# Keep their Unity .meta files and the hash-verified restore manifest in Git.
/native/Assets/Art/Quaternius/Nature/Textures/Bark_DeadTree_Normal.png
/native/Assets/Art/Quaternius/Nature/Textures/Bark_TwistedTree_Normal.png
/native/Assets/Art/Quaternius/Props/Textures/T_Page_Noise.png

