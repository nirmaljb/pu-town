# Preserve exact source and license bytes from the retained creator archives.
campus/assets/avatars/sources/quaternius/** -text -whitespace
campus/assets/sources/quaternius/** -text -whitespace
campus/assets/sources/quaternius-character/** -text -whitespace

# Unity serializers emit spaces after empty YAML values.
native/Assets/**/*.meta -whitespace
native/Assets/**/*.prefab -whitespace
native/Assets/**/*.mat -whitespace
native/Assets/**/*.controller -whitespace
native/Assets/**/*.unity -whitespace
native/Assets/**/*.asset -whitespace
native/ProjectSettings/*.asset -whitespace

# Preserve the supplied font license text exactly.
native/Assets/PUtown/Fonts/OFL.txt -text -whitespace

# Keep pinned generator/OpenFL source and supplied town licenses byte-exact.
tools/towns/vendor/** -text -whitespace
towns/assets/sources/kaykit/*License.txt -text -whitespace
towns/assets/sources/quaternius/*License* -text -whitespace
