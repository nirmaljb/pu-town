    "avatars": "python3 ../tools/avatar-editor/server.py"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "typescript": "^5.7.2",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  }
}
